# Kunci master API (wajib diisi dengan kunci acak yang kuat). Bila kosong,
# server membuat kunci sementara saat start (berlaku sampai restart).
OPENONGKIR_API_KEY=
# Path DB SQLite (default: data/openongkir.db).
OPENONGKIR_DB=data/openongkir.db
# Port HTTP (default: 3000).
OPENONGKIR_PORT=3000
# Interval perawatan harian di dalam service (ms). Default 24 jam; 0 = mati.
# OPENONGKIR_REFRESH_INTERVAL_MS=86400000
# Jumlah rute yang di-refresh / di-spot-check per jalan perawatan.
# OPENONGKIR_REFRESH_LIMIT=10
# OPENONGKIR_SPOTCHECK_LIMIT=5
